# Azure Entra ID (Para conectar con SharePoint)
AZURE_CLIENT_ID=tu_client_id_aqui
AZURE_TENANT_ID=tu_tenant_id_aqui
AZURE_CLIENT_SECRET=tu_client_secret_aqui

# Supabase (Destino final y estado)
SUPABASE_URL=tu_supabase_url_aqui
SUPABASE_KEY=tu_supabase_service_role_key_aqui

# Azure OpenAI (Para generar los embeddings de los documentos)
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=tu_api_key_de_azure_openai_aqui
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=512
