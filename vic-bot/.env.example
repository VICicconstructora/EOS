# =============================================
# VIC Bot — Variables de entorno
# Copiar a .env y completar los valores reales
# =============================================

# Azure Bot Service (Luis Miguel registra el bot en Azure → obtiene estos dos valores)
BOT_APP_ID=your-azure-bot-app-id
BOT_APP_PASSWORD=your-azure-bot-app-password

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase (service role key — bypasa RLS, solo usar en servidor)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ruta local al wiki de Obsidian (solo necesaria para correr el indexador)
WIKI_PATH=C:/Users/jmacallister/OneDrive - IC CONSTRUCTORA SAS/Documentos/ICEOS/IC-EOS

# Puerto del servidor
PORT=3978
