# ─── sync-datamart — Variables de entorno ───────────────────────────────────
# Copia este archivo como .env o configura las variables en el bat wrapper.
# El script funciona sin estas variables; omite las integraciones que no estén.

# ─── Rutas (opcionales) ──────────────────────────────────────────────────────

# Ruta local al archivo Datamart.xlsx descargado de SharePoint
# (sites/GND/DataMart/Datamart.xlsx)
# NOTA: En producción esto corre automáticamente en la nube vía
#       app/supabase/functions/datamart-sync/ — este script es solo fallback local.
DATAMART_PATH=C:/ruta/local/Datamart.xlsx

# Raíz del repositorio (detectado automáticamente si no se define)
# REPO_ROOT=C:/Users/Administrador/OneDrive/Documentos/Documentos/Traccion

# ─── Supabase (para escribir alarmas en la DB del portal EOS) ────────────────
# Obtener de: Supabase Dashboard → Settings → API → service_role key
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Email SMTP — Office 365 ─────────────────────────────────────────────────
# Cuenta que enviará el correo (debe tener SMTP AUTH habilitado en Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificaciones@icconstructora.com
SMTP_PASS=tu_contraseña_aqui
SMTP_FROM=notificaciones@icconstructora.com

# Destinatarios (separados por coma)
SMTP_TO=jmcallister@icconstructora.com,jmanosalva@icconstructora.com
