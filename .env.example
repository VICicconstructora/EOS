# ==============================================================================
# IC Constructora / Traccion — credenciales centralizadas (PLANTILLA)
# ------------------------------------------------------------------------------
# Copia este archivo como `.env` en la RAÍZ del repo y llena los valores.
# Es la FUENTE ÚNICA: todos los subproyectos lo cargan desde aquí. No crear
# .env por carpeta. El .env real está en .gitignore y nunca se commitea.
#
# Cargadores que apuntan aquí:
#   - vic-bot/*           (Node, dotenv → ../../.env)
#   - app/, apps/total/frontend/ (Vite, envDir)
#   - apps/indicadores/, apps/total/backend/, sharepoint-scraper/ (Python, load_dotenv)
#   - scripts/sync-datamart/ (loader inline sin dependencias)
# ==============================================================================

# ----- COMPARTIDO -----
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # service_role (admin). NO exponer al frontend.
SUPABASE_KEY=                       # alias del service_role (sharepoint-scraper, export_mirror)
SUPABASE_SERVICE_KEY=               # alias del service_role (scripts/sync-datamart)
AZURE_TENANT_ID=                    # tenant Entra ID (mismo para todos los registros)
ANTHROPIC_API_KEY=                  # unificada para todos los subproyectos
GEMINI_API_KEY=                     # unificada para todos los subproyectos

# ----- app/ (Vite frontend + Azure datamart 'Traccion-IC') -----
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=             # anon/public (segura de exponer en el bundle)
VITE_SUPABASE_IC_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_IC_ANON_KEY=
AZURE_CLIENT_ID=                    # registro 'Traccion-IC' (edge fn datamart-sync + sync-datamart)
AZURE_CLIENT_SECRET=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=

# ----- vic-bot/ (Teams bot) -----
BOT_APP_ID=
BOT_APP_PASSWORD=
BOT_APP_TENANT_ID=                  # = AZURE_TENANT_ID
VOYAGE_API_KEY=
WIKI_PATH=                          # ruta de DATOS al wiki Obsidian (local, fuera del repo)
PORT=3978
VIC_KEYS_SECRET=                    # se inyecta como secreto en Azure (no en local)
VIC_PUSH_SECRET=                    # se inyecta como secreto en Azure/Job
# El wiki de VIC se lee EN VIVO desde SharePoint (Graph Search), no desde Supabase.
# Reusa el registro de Azure del scraper (mismas credenciales que SP_AZURE_CLIENT_ID/SECRET
# más abajo) porque ya tiene permiso de aplicación (Sites.Read.All) sobre todo el tenant.
SP_SEARCH_REGION=NAM                # requerido por Graph Search con permiso de aplicación
VIC_WIKI_NOISE_PATHS=                # opcional: rutas a excluir del primer paso de búsqueda
VIC_RESTRICTED_PATHS=                # opcional: "substring1|scope1,substring2|scope2"

# ----- vic-bot: proveedor LLM dual (Anthropic + OpenAI-compatible) -----
# Primario para todos = NVIDIA (gratis). Anthropic (Claude) solo para quien
# registra su propia key con /registrar-key sk-ant-...; quien no la registra no
# llega a Anthropic. El fallback es cruzado: si el primario falla, se usa el otro.
VIC_OPENAI_API_KEY=                 # key del endpoint OpenAI-compatible primario (NVIDIA: nvapi-...)
VIC_ANTHROPIC_API_KEY=              # key compartida de Claude; si falta se usa ANTHROPIC_API_KEY. Ignorada salvo VIC_SHARED_ANTHROPIC=1
VIC_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Lista de candidatos separados por coma: ante 404/410 (NVIDIA retira modelos
# con poco aviso) VIC pasa al siguiente sin quedarse mudo.
VIC_OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b,deepseek-ai/deepseek-v4-pro-0813
VIC_OPENAI_TEMPERATURE=0.2
VIC_OPENAI_TOP_P=0.7
# Modelo de Anthropic para VIC. Opus 5 desde el 2026-09-11 (antes
# claude-sonnet-4-6, generación anterior y más cara que Sonnet 5).
VIC_ANTHROPIC_MODEL=claude-opus-5
# VIC_MAX_TOKENS=8000                     # opcional, aplica a ambos proveedores (default 8000)
# VIC_MAX_ITERATIONS=10                   # opcional, pasos del agentic loop (default 10)
# VIC_SHARED_ANTHROPIC=1                  # opcional, revive la key compartida de Claude para quien no
#                                         # registró la suya. Apagada desde el 2026-09-11: ese fallback
#                                         # silencioso agotó el saldo en un día (6 personas sobre Opus,
#                                         # sin prompt caching, con consultas de hasta 1.08M tokens).
# VIC_DEFAULT_PROVIDER=openai             # OBSOLETA desde el 2026-09-11: el código ya no la lee. El orden
#                                         # lo decide la key propia de quien pregunta, no el entorno.

# ----- sharepoint-scraper/ (registro Azure propio 'Claude-SharePoint-Actas') -----
# sharepoint_scraper.py está RETIRADO (indexaba a Supabase, que ya no existe).
# local_ingest.py / local_ocr_ingest.py SÍ están activos: suben lo que ingestan
# a SharePoint (sharepoint_upload.py), no a Supabase. Reusan SP_AZURE_CLIENT_ID/
# SECRET (confirmado con permiso de escritura, Sites.ReadWrite.All).
SP_AZURE_CLIENT_ID=                 # distinto al AZURE_CLIENT_ID de app
SP_AZURE_CLIENT_SECRET=
LOCAL_INGEST_DRIVE_ID=               # opcional: default = drive 'AA General Edicion' ya verificado
LOCAL_INGEST_TARGET_ROOT=.AI/_local-ingest  # opcional: carpeta destino dentro del drive
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=512
SHAREPOINT_SITES=icconstructora.sharepoint.com:/sites/GND
SHAREPOINT_LIBRARIES=
MAX_FILES_PER_RUN=2000
SLEEP_BETWEEN_FILES=1.5
VIC_PUSH_URL=https://vic-ic-constructora.azurewebsites.net/api/push
NOTIFY_EMAIL=
# Gobierno de acceso al conocimiento sensible de VIC (buzones .pst en pst-ingest/).
# Listas separadas por coma de emails AAD. CEO ve all+ceo+restricted; Jurídico
# ve all+restricted; el resto solo 'all'. Vacío = nadie con acceso elevado.
CEO_EMAILS=
LEGAL_EMAILS=

# ----- apps/total/ (frontend Vite + backend Flask) -----
VITE_APP_USER=admin
VITE_APP_PASS=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_TENANT_ID=
SITE_1_URL=
SITE_1_FILE_PATH=
SITE_2_URL=
SITE_2_FILE_PATH=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_RECEIVER=

# ----- apps/indicadores/ -----
SUPABASE_DB_URI="host=<host> port=6543 user=<user> password=<pwd> dbname=postgres"
